# ==============================================================================
# T7 PRINT HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production
PORT=3000

# MySQL Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=t7_printhub
DB_USER=t7_db_user
DB_PASSWORD=your_secure_db_password

# Firebase Admin SDK Credentials (AUTHENTICATION ONLY)
FIREBASE_PROJECT_ID=printing-app-9a63f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@printing-app-9a63f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Hostinger VPS Storage Path
STORAGE_DIR=/var/www/t7-printhub/storage
