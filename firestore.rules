rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // T7-PrintHub currently uses its own admin session rather than Firebase Auth.
    // These rules therefore keep the existing app functional. Before public production,
    // migrate admin writes to Firebase Auth/custom claims and tighten write access.

    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /bookingRequests/{bookingId} {
      allow read, write: if true;
    }

    // Keep compatibility with older catalog documents if they exist.
    match /catalog/{catalogId} {
      allow read, write: if true;
    }
  }
}
