rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Order original files path: orders/{orderId}/original/{fileName}
    match /orders/{orderId}/original/{fileName} {
      // Allow customers to upload original files (PDF, DOC, DOCX, JPG, PNG, WEBP up to 200MB)
      allow write: if request.resource.size < 200 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                       || request.resource.contentType.matches('image/.*'));

      allow read: if true;
      allow delete: if true;
    }

    // Payment receipts path: receipts/{fileName}
    match /receipts/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if true;
    }

    // Payment proof path: payment-proofs/{orderId}/{fileName}
    match /payment-proofs/{orderId}/{fileName} {
      // Allow customers to upload payment proof images (JPG, JPEG, PNG, WEBP up to 10MB)
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow read: if true;
      allow delete: if true;
    }

    // AWB slips uploaded by admin application
    match /awb-slips/{orderId}/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow read: if true;
      allow delete: if true;
    }

    // T7 Shop product/service images
    match /catalog/{catalogType}/{itemId}/{fileName} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
      allow read: if true;
      allow delete: if true;
    }

    // Creator image & About assets path: about/{allPaths=**}
    match /about/{allPaths=**} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
      allow read: if true;
      allow delete: if true;
    }

    // Default fallback paths for general shop assets
    match /uploads/{fileName} {
      allow read, write: if true;
    }
    match /customer_docs/{fileName} {
      allow read, write: if true;
    }
  }
}
