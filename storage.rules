rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active != false
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function allowedDocumentType() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        || request.resource.contentType.matches('image/.*');
    }

    match /orders/{orderId}/original/{fileName} {
      allow create, update: if request.resource.size < 200 * 1024 * 1024
                            && allowedDocumentType();
      // Tokenized download URLs may be shared with the customer.
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /receipts/{fileName} {
      allow create, update: if request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /awb-slips/{orderId}/{fileName} {
      allow create, update: if isAdmin()
                            && request.resource.size < 15 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType == 'application/pdf');
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /service_docs/{bookingId}/{fileName} {
      allow create, update: if request.resource.size < 20 * 1024 * 1024
                            && allowedDocumentType();
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /product_images/{productId}/{fileName} {
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && (request.resource.contentType.matches('image/jpeg')
                                || request.resource.contentType.matches('image/png')
                                || request.resource.contentType.matches('image/webp'));
      allow read: if true;
      allow delete: if isAdmin();
    }

    match /product_images/{fileName} {
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAdmin();
    }

    // General shop assets must be managed by an authenticated admin.
    match /uploads/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customer_docs/{fileName} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
