rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Order original files path: orders/{orderId}/original/{fileName}
    match /orders/{orderId}/original/{fileName} {
      // Allow customers to upload original files (PDF, DOC, DOCX, JPG, PNG, WEBP up to 200MB)
      allow write: if request.resource.size < 200 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                       || request.resource.contentType.matches('image/.*'));

      // Allow read access for authenticated admins or direct link holders
      allow read: if true;

      // Allow deletion by admin or automated cleanup routine
      allow delete: if true;
    }

    // Payment receipts path: receipts/{fileName}
    match /receipts/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if true;
    }


    // AWB slips uploaded by the existing admin application.
    // NOTE: the current project uses a local admin session rather than Firebase Auth,
    // so strict request.auth enforcement would break the current frontend. Migrate
    // admin login to Firebase Auth/custom claims before tightening this rule.
    match /awb-slips/{orderId}/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow read: if true;
      allow delete: if true;
    }

    // T7 Shop product/service images
    match /catalog/{catalogType}/{itemId}/{fileName} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
      allow read: if true;
      allow delete: if true;
    }

    // Creator image & About assets path: about/{allPaths=**}
    match /about/{allPaths=**} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
      allow read: if true;
      allow delete: if true;
    }

    // Default fallback paths for general shop assets
    match /uploads/{fileName} {
      allow read, write: if true;
    }
    match /customer_docs/{fileName} {
      allow read, write: if true;
    }
  }
}
